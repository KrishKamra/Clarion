<?xml version="1.0" encoding="utf-8"?>
<!-- Type for the home widget, mirroring AppTypography: tabular figures for
     anything compared, tracked mono overlines for micro labels. -->
<resources>
    <style name="ClarionWidget" />

    <style name="ClarionWidget.Figure">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:text">@string/widget_preview_budget</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <style name="ClarionWidget.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:text">@string/widget_preview_caption</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ClarionWidget.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ClarionWidget.Overline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/widget_text_tertiary</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ClarionWidget.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_tile</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>
</resources>
