<?xml version="1.0" encoding="utf-8"?>
<!-- Floating tier: sheen pooled top-left, falling to the surface, with a
     hairline rim — the same light as every in-app card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:endColor="@color/widget_surface"
        android:startColor="@color/widget_surface_top"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/widget_rim" />
</shape>
