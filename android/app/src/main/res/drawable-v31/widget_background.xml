<?xml version="1.0" encoding="utf-8"?>
<!-- As drawable/widget_background.xml, with the launcher's own corner
     radius so the widget sits flush with its neighbours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <gradient
        android:angle="315"
        android:endColor="@color/widget_surface"
        android:startColor="@color/widget_surface_top"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/widget_rim" />
</shape>
