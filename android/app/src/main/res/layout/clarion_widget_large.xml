<?xml version="1.0" encoding="utf-8"?>
<!-- 4×3 and up: the medium widget plus the watchlist and what waiting has
     saved, as three quiet tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/clarion_widget_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring_preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_budget"
                style="@style/ClarionWidget.Figure"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/widget_caption"
                style="@style/ClarionWidget.Caption" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/clarion_widget_hold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/ClarionWidget.Tile"
            android:layout_marginEnd="8dp">

            <TextView
                style="@style/ClarionWidget.Overline"
                android:text="@string/widget_watching" />

            <TextView
                android:id="@+id/widget_watching"
                style="@style/ClarionWidget.Figure"
                android:layout_marginTop="4dp"
                android:text="5"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/widget_at_target"
                style="@style/ClarionWidget.Caption"
                android:text="2 at target"
                android:textColor="@color/widget_good" />
        </LinearLayout>

        <LinearLayout style="@style/ClarionWidget.Tile">

            <TextView
                style="@style/ClarionWidget.Overline"
                android:text="@string/widget_saved" />

            <TextView
                android:id="@+id/widget_saved"
                style="@style/ClarionWidget.Figure"
                android:layout_marginTop="4dp"
                android:text="₹3,200"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/widget_avoided"
                style="@style/ClarionWidget.Caption"
                android:text="7 impulses skipped" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
