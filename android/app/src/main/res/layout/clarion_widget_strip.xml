<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1: ring and figure on the left; the soonest hold on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ring_preview" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_budget"
            style="@style/ClarionWidget.Figure"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/widget_caption"
            style="@style/ClarionWidget.Caption"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:background="@color/widget_hairline" />

    <LinearLayout
        android:id="@+id/widget_hold_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_hold_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot_over" />

            <TextView
                android:id="@+id/widget_hold_title"
                style="@style/ClarionWidget.Body"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/widget_preview_hold"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_hold_time"
            style="@style/ClarionWidget.Caption"
            android:fontFeatureSettings="tnum"
            android:text="@string/widget_preview_ready"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
